# ============================================================================
# mental_health_research — Git Ignore
# ============================================================================

# --- Virtual environment ---
.venv/
venv/
env/
ENV/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Markdown documentation ---
*.md
!README.md
!REPORT.md

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Model caches (large files) ---
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
models/
~/.cache/

# --- Local data / outputs (keep only sources) ---
# Uncomment if you want to ignore all data/ outputs
# data/*.csv
# data/*.md

# --- Logs ---
*.log

# --- Archives ---
archive/
